# Database (PostgreSQL 17 local Docker or Neon)
DATABASE_URL=postgresql://recipes:recipes@localhost:5432/recipes_db

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-char-random-secret-in-production
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional in local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# UploadThing (optional in local dev)
UPLOADTHING_TOKEN=

# Upstash Redis Rate Limiting (optional in local dev - falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Recipe Parser (optional in local dev - JSON-LD $0 parser works without keys)
# Use GOOGLE_GENERATIVE_AI_API_KEY (Google AI Studio free tier, e.g. gemini-3.5-flash-lite)
# or OpenAI-compatible provider (OpenRouter / Groq) via AI_BASE_URL + OPENAI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=gemini-3.5-flash-lite

# Telegram Moderation Webhook (optional in local dev)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Vercel Cron Secret
CRON_SECRET=local-cron-secret
